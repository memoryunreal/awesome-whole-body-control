# Copy to .env. Do not commit .env or share app passwords in chat.
# Gmail: enable 2-step verification and create an app password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_DAYS=14

# OpenAI or an OpenAI-compatible endpoint for evidence-backed deep reports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: raises Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=
